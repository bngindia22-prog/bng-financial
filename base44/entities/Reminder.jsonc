{
  "name": "Reminder",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Reminder title"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Reminder date"
    },
    "type": {
      "type": "string",
      "enum": [
        "bill",
        "emi",
        "insurance",
        "investment",
        "other"
      ],
      "description": "Type of reminder"
    },
    "amount": {
      "type": "number",
      "description": "Amount due"
    },
    "recurring": {
      "type": "boolean",
      "default": false,
      "description": "Is this a recurring reminder"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "title",
    "date",
    "type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}